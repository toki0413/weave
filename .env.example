# ============ 织忆 · 认知花园 部署环境变量 ============
# 用法：cp .env.example .env，填写后 docker compose --profile with-nginx up -d
# 说明：标【必填】的变量缺失时 compose 会拒绝启动（防止以默认凭据上线）。

# ---- 数据库与缓存【必填】----
CG_PG_PASSWORD=
CG_REDIS_PASSWORD=

# ---- 应用密钥【必填】----
# JWT 签名密钥，生成：openssl rand -hex 32
# 注意：更换该值会使所有已签发 token 失效（用户需重新登录）
CG_JWT_SECRET=

# ---- KMS 主密钥包装 ----
# env 模式下必填：base64 编码的 32 字节随机密钥
# 生成：python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# file 模式用于单机开发；aws 模式需同时配置 CG_KMS_KEY_ID 与 AWS 凭证
CG_KMS_PROVIDER=env
CG_KMS_MASTER_KEY=
# CG_KMS_KEY_ID=
# CG_KMS_AWS_REGION=ap-guangzhou

# ---- 跨域（同源反代部署可留空）----
# 前端与 API 不同域时填写，逗号分隔，例如 https://weave.example.com
CG_CORS_ORIGINS=

# ---- 监控端点访问控制（可选）----
# 配置后 /metrics 要求 Authorization: Bearer <token>；
# 留空时仅允许环回/私网来源（Prometheus 走容器网络即可）
CG_METRICS_TOKEN=

# ---- 部署形态开关（一般无需修改）----
# CG_SERVE_UPLOADS=0        # 语音密文目录不对外暴露（默认安全策略）
# CG_TRUST_PROXY=1          # 前置反代可信时按真实客户端 IP 限流
# CG_ALLOW_CREATE_ALL=0     # 迁移失败时禁止降级 create_all（生产必须保持 0）

# ---- ASR / LLM（可选，未配置时降级为离线 Vosk / 题库原题）----
# 火山引擎一句话识别：三项齐备才启用
# asr_volc_app_id=
# asr_volc_token=
# asr_volc_cluster=
# 阿里云百炼（qwen3-asr-flash 兜底）
# bailian_api_key=
# LLM 个性化追问
# llm_provider=
# llm_api_key=
# llm_model=

# ---- 告警出站触达（可选，留空则仅应用内通知）----
# smtp_host=
# smtp_port=465
# smtp_user=
# smtp_password=
# alert_webhook_url=
